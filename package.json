{
  "name": "web-video-player",
  "version": "3.0.0",
  "type": "module",
  "main": "src/app.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinkermakar/wvplayer.git"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/app.ts",
    "start": "node --env-file=.env src/app.ts",
    "start:docker": "node src/app.ts",
    "tsc-lint": "tsc --noUnusedLocals --noUnusedParameters",
    "eslint": "eslint src",
    "prettier": "prettier --ignore-path .gitignore --ignore-path .hbs-ignore --write .",
    "lint": "npm run tsc-lint && npm run eslint"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "hbs": "^4.4.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/hbs": "^4.0.5",
    "@types/morgan": "^1.9.10",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
